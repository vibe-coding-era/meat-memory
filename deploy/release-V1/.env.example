# Meat Memory release-V1 binary deployment environment.
# Copy this file to `.env` in the same directory before running `./dev-up.sh`.

MEAT_MEMORY_INSTALL_DIR=./bin
MEAT_MEMORY_CONFIG_DIR=./config
MEAT_MEMORY_TUI_CONFIG=./config/app.local.toml
MEAT_MEMORY_RUN_TUI=auto
MEAT_MEMORY_INSTALL_MISSING_DEPS=0
MEAT_MEMORY_CONFIG=./config/app.toml
MEAT_MEMORY_SERVER_BIND=127.0.0.1:8080
MEAT_MEMORY_MARKDOWN_ROOT=./data/markdown
MEAT_MEMORY_ASSETS_ROOT=./data/assets
MEAT_MEMORY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/meat_memory_dev
MEAT_MEMORY_SKIP_DB_CHECK=0
MEAT_MEMORY_ENABLE_HTTP=true
MEAT_MEMORY_ENABLE_MCP=false
RUST_LOG=info
