MEAT_MEMORY_CONFIG=/etc/meat-memory/app.toml
MEAT_MEMORY_SERVER_BIND=0.0.0.0:8080
MEAT_MEMORY_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meat_memory
MEAT_MEMORY_MARKDOWN_ROOT=/var/lib/meat-memory/docs
MEAT_MEMORY_ASSETS_ROOT=/var/lib/meat-memory/assets
MEAT_MEMORY_ENABLE_MCP=true
RUST_LOG=info
