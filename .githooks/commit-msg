#!/usr/bin/env bash
set -euo pipefail

COMMIT_MSG_FILE="${1:?commit message path is required}"
HEADER="$(head -n 1 "${COMMIT_MSG_FILE}")"
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if [[ ! "${HEADER}" =~ ${PATTERN} ]]; then
  cat <<'EOF'
Commit message must follow Conventional Commits.
Example:
  feat(store-md): add markdown roundtrip parser
EOF
  exit 1
fi
