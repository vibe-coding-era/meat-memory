# Meat Memory 环境变量示例
# 用途：给本地开发、脚本验证、`cargo run` 和 Docker 调试提供最小环境变量。
# 使用方式：
# 1. 复制为 `.env`：`cp .env.example .env`
# 2. 按需修改配置文件路径、数据库地址和日志级别
# 3. 再执行 `./scripts/dev-up.sh`、`cargo run -p memory-app` 或 `./scripts/verify.sh`

MEAT_MEMORY_CONFIG=config/default.toml
MEAT_MEMORY_PGVECTOR_URL=postgres://postgres:postgres@127.0.0.1:5433/meat_memory_dev
MEAT_MEMORY_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/meat_memory_dev
RUST_LOG=info
